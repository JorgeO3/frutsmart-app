{
  "expo": {
    "name": "FrutSmart",
    "slug": "frutosmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "bundleIdentifier": "com.anonymous.frutosmart"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.frutosmart",
      "runtimeVersion": "1.0.0",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Frutosmart necesita acceso a tus fotos para guardar los reportes generados.",
          "savePhotosPermission": "Permitir que Frutosmart guarde los reportes en tu dispositivo.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "osm-devel"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e0ae12af-d933-4ef8-8d73-3287e88f5f2e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e0ae12af-d933-4ef8-8d73-3287e88f5f2e"
    },
    "sdkVersion": "53.0.0"
  }
}
