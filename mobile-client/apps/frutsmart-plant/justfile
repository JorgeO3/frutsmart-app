    @echo -e "{{GREEN}}✅ Skybolt contract tests completados.{{NORMAL}}"

[doc('Run Skybolt smoke-test placeholder.')]
skybolt_smoke: setup
    @echo -e "{{MAGENTA}}🔥 Ejecutando smoke suite Skybolt...{{NORMAL}}"
    @just skybolt_test_js
    @just skybolt_test_jvm
    @just skybolt_test_uploader
    @just skybolt_contract_test
    @cd android; and env JAVA_HOME=/usr/lib/jvm/java-21-openjdk ./gradlew :skybolt:assembleDebug :skybolt:assembleDebugAndroidTest
    @echo -e "{{GREEN}}✅ Smoke suite Skybolt completada.{{NORMAL}}"

[doc('Run full local-only Skybolt validation gate.')]
skybolt_local_gate: setup
    @echo -e "{{CYAN}}🏁 Ejecutando gate local Skybolt (sin nube)...{{NORMAL}}"
    @just ts_check
    @just skybolt_test_js
    @just skybolt_test_jvm
    @just skybolt_test_uploader
    @just skybolt_contract_test
    @just skybolt_benchmark
    @just skybolt_perf_android
    @just skybolt_soak
    @just skybolt_stability_android
    @just skybolt_test_android
    @echo -e "{{GREEN}}✅ Gate local Skybolt completado.{{NORMAL}}"

[doc('Prepare and run app-side manual smoke prerequisites.')]
skybolt_smoke_app_prep: setup
    @echo -e "{{MAGENTA}}📱 Preparando smoke manual app-side...{{NORMAL}}"
    @cd android; and env JAVA_HOME=/usr/lib/jvm/java-21-openjdk ./gradlew :app:assembleDebug
    @echo -e "{{YELLOW}}📝 Sigue el runbook en docs/skybolt_smoke_app_manual.md{{NORMAL}}"

[doc('Run app-side smoke gate (build/install/launch/log sanity).')]
skybolt_smoke_app_gate: setup
    @echo -e "{{MAGENTA}}📱 Ejecutando smoke gate app-side...{{NORMAL}}"
    @cd android; and env JAVA_HOME=/usr/lib/jvm/java-21-openjdk ./gradlew :app:assembleDebug :app:assembleRelease
    @./scripts/skybolt_smoke_app_gate.sh
    @echo -e "{{GREEN}}✅ Smoke gate app-side completado.{{NORMAL}}"

[doc('Try release assemble for visibility (non-blocking).')]
skybolt_smoke_app_release_try: setup
    @echo -e "{{MAGENTA}}📦 Intentando assembleRelease (diagnostico)...{{NORMAL}}"
    @cd android; and env JAVA_HOME=/usr/lib/jvm/java-21-openjdk ./gradlew :app:assembleRelease; or true
    @echo -e "{{YELLOW}}ℹ️  Si falla release, revisar output R8; no bloquea gate local smoke.{{NORMAL}}"

[doc('Start local smoke evidence capture (logcat + final screenshot).')]
skybolt_smoke_capture_start:
    @./scripts/skybolt_smoke_capture.sh start

[doc('Stop local smoke evidence capture and persist artifacts.')]
skybolt_smoke_capture_stop:
    @./scripts/skybolt_smoke_capture.sh stop

[doc('Show local smoke evidence capture status.')]
skybolt_smoke_capture_status:
    @./scripts/skybolt_smoke_capture.sh status

