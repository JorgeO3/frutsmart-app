<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <service
      android:name="expo.modules.nanort.module.interpreter.soak.SoakRunnerService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <receiver
      android:name="expo.modules.nanort.module.interpreter.soak.SoakControlReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="expo.modules.nanort.soak.START" />
        <action android:name="expo.modules.nanort.soak.STOP" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
