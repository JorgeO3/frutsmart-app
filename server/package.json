{
	"name": "frutsmart-back",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome lint --fix src test",
		"check": "tsc --noEmit",
		"test": "npm run test:unit",
		"test:unit": "NODE_ENV=test jest -c jest.unit.config.ts --maxWorkers=50%",
		"test:unit:watch": "NODE_ENV=test jest -c jest.unit.config.ts --watch --maxWorkers=50%",
		"test:unit:cov": "NODE_ENV=test jest -c jest.unit.config.ts --coverage --maxWorkers=50%",
		"test:upload": "NODE_ENV=test jest -c jest.unit.config.ts --maxWorkers=50% src/modules/upload",
		"test:upload:watch": "NODE_ENV=test jest -c jest.unit.config.ts --watch --maxWorkers=50% src/modules/upload",
		"test:upload:cov": "NODE_ENV=test jest -c jest.unit.config.ts --coverage --maxWorkers=50% src/modules/upload",
		"test:int": "NODE_ENV=test jest -c jest.int.config.ts --maxWorkers=50%",
		"test:int:watch": "NODE_ENV=test jest -c jest.int.config.ts --watch --maxWorkers=50%",
		"test:int:cov": "NODE_ENV=test jest -c jest.int.config.ts --coverage --maxWorkers=50%",
		"test:e2e": "NODE_ENV=test jest -c test/jest-e2e.config.ts --runInBand",
		"test:e2e:cov": "NODE_ENV=test jest -c test/jest-e2e.config.ts --coverage --runInBand",
		"test:all": "npm run test:unit && npm run test:int && npm run test:e2e",
		"test:all:cov": "npm run test:unit:cov && npm run test:int:cov && npm run test:e2e:cov",
		"test:watch": "npm run test:unit:watch",
		"test:cov": "npm run test:all:cov",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register node_modules/.bin/jest --runInBand",
		"test:endpoints": "ts-node --project tsconfig.scripts.json scripts/test-all-endpoints.ts",
		"typeorm": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js",
		"migration:generate": "bun run typeorm -- -d src/database/data-source.ts migration:generate",
		"migration:create": "bun run typeorm -- migration:create",
		"migration:run": "bun run typeorm -- -d src/platform/database/data-source.ts migration:run",
		"migration:revert": "bun run typeorm -- -d src/platform/database/data-source.ts migration:revert",
		"migration:show": "bun run typeorm -- -d src/platform/database/data-source.ts migration:show",
		"migration:status": "ts-node scripts/migration-status.ts",
		"schema:drop": "bun run typeorm -- -d src/platform/database/data-source.ts schema:drop",
		"schema:log": "bun run typeorm -- -d src/platform/database/data-source.ts schema:log"
	},
	"dependencies": {
		"@azure/identity": "~4.12.0",
		"@azure/storage-blob": "~12.28.0",
		"@fastify/compress": "~8.1.0",
		"@fastify/helmet": "~13.0.1",
		"@fastify/rate-limit": "~10.3.0",
		"@fastify/static": "~8.2.0",
		"@nestjs/axios": "~4.0.1",
		"@nestjs/common": "~11.0.1",
		"@nestjs/config": "~4.0.2",
		"@nestjs/core": "~11.0.1",
		"@nestjs/platform-fastify": "~11.1.6",
		"@nestjs/swagger": "~11.2.0",
		"@nestjs/terminus": "~11.0.0",
		"@nestjs/throttler": "~6.4.0",
		"@nestjs/typeorm": "~11.0.0",
		"axios": "~1.12.2",
		"class-transformer": "~0.5.1",
		"class-validator": "~0.14.2",
		"dotenv": "~17.2.2",
		"nestjs-pino": "~4.4.1",
		"pg": "~8.16.3",
		"pino-http": "~10",
		"reflect-metadata": "~0.2.2",
		"rxjs": "~7.8.1",
		"typeorm": "~0.3.26"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@eslint/eslintrc": "~3.2.0",
		"@eslint/js": "~9.18.0",
		"@nestjs/cli": "~11.0.0",
		"@nestjs/schematics": "~11.0.0",
		"@nestjs/testing": "~11.0.1",
		"@swc/cli": "~0.7.8",
		"@swc/core": "~1.13.5",
		"@swc/jest": "~0.2.39",
		"@types/jest": "~30.0.0",
		"@types/node": "~22.10.7",
		"@types/supertest": "~6.0.2",
		"@typescript/native-preview": "~7.0.0-dev.20251005.1",
		"eslint": "~9.18.0",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-prettier": "~5.2.2",
		"globals": "~16.0.0",
		"jest": "~30.0.0",
		"pino-pretty": "~13.1.1",
		"prettier": "~3.4.2",
		"source-map-support": "~0.5.21",
		"supertest": "~7.0.0",
		"ts-loader": "~9.5.2",
		"ts-node": "~10.9.2",
		"tsconfig-paths": "~4.2.0",
		"typescript": "~5.7.3",
		"typescript-eslint": "~8.20.0"
	}
}
