{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"outDir": "./dist/scripts"
	},
	"include": ["scripts/**/*"],
	"exclude": ["node_modules", "dist"]
}
