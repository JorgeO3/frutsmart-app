# ===========================================
# COMPILED OUTPUT & BUILD ARTIFACTS
# ===========================================
/dist
/build
*.tsbuildinfo
.build/

# ===========================================
# NODE.JS DEPENDENCIES
# ===========================================
**/node_modules/
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================================
# ENVIRONMENT VARIABLES & SECRETS
# ===========================================
# Local environment files (these should NEVER be committed)
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Backup env files
*.env.backup
*.env.bak

# ===========================================
# LOGS & RUNTIME DATA
# ===========================================
logs/
*.log
.npm
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# PM2 logs (if ever used in development)
.pm2/

# ===========================================
# TESTING & COVERAGE
# ===========================================
/coverage
/.nyc_output
/test-results/
junit.xml

# Test data (images, files) - keep directory structure only
test-data/*
!test-data/.gitkeep
!test-data/README.md

# ===========================================
# CACHING & TEMPORARY FILES
# ===========================================
.jest-cache/
.cache/
.temp/
.tmp/
*.tmp
*.temp

# TypeScript cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# ===========================================
# DATABASE & STORAGE
# ===========================================
# Local database files
*.sqlite
*.db
*.sqlite3

# Database dumps
*.sql.gz
*.dump

# Local uploads/storage
uploads/
storage/
public/uploads/

# ===========================================
# OPERATING SYSTEM FILES
# ===========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ===========================================
# IDE & EDITOR CONFIGURATIONS
# ===========================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# JetBrains IDEs
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ===========================================
# DOCKER & CONTAINERIZATION
# ===========================================
# Docker override files (for local development)
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes data
.docker/
docker-data/

# ===========================================
# CLOUD & DEPLOYMENT
# ===========================================
# Azure
.azure/

# AWS
.aws/

# Serverless
.serverless/

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# ===========================================
# SECURITY & CERTIFICATES
# ===========================================
# SSL certificates
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.pub
known_hosts

# ===========================================
# BACKUP & ARCHIVE FILES
# ===========================================
*.backup
*.bak
*.old
*.orig
*.rej
*.zip
*.tar.gz
*.rar

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
# Storybook
storybook-static/

# Next.js
.next/
out/

# Nuxt.js
.nuxt/
.output/

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# New Relic
newrelic.js
newrelic_agent.log

# ===========================================
# MISC FILES TO IGNORE
# ===========================================
# Lock files (keep package-lock.json but ignore others if using different package managers)
# yarn.lock    # Uncomment if not using Yarn
# pnpm-lock.yaml    # Uncomment if not using PNPM

# Local configuration overrides
config.local.*
*.local.json

# Documentation builds
docs/build/

# Benchmark results
benchmark/

# Temporary or backup modules
src/modules/upload_backup

# Temporary files created by various tools
src/modules/staging

trash/

docker/

# ===========================================
# TERRAFORM
# ===========================================
# Ignore everything in terraform/
terraform/*

# But keep .tf files
!terraform/*.tf
!terraform/**/*.tf

# Explicitly ignore these
terraform/certs
terraform/.terraform
terraform/.terraform.lock.hcl
terraform/*.tfvars
terraform/tfplan
terraform/*.sh
terraform/*.ipynb